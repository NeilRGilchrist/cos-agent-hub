AGENTS.override.md
CLAUDE.local.md

# Dispatch state (locks, logs, last-tick marker) — local-only.
_dispatch/

# Per-FR developer/reviewer git worktrees — local-only.
.claude/worktrees/

# PR body is generated per-FR by the dispatcher and consumed by
# `gh pr create --body-file`. It must not be committed.
PR_BODY.md

# Python bytecode and tool caches. The team scripts under scripts/ are always
# Python and are exercised by tests/unit/scripts/, so these appear in every
# project regardless of the project's own stack.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
